# name: test/sql/scanner/http_sqlite_url.test
# description: Test with INSTALL, LOAD and then a URL
# group: [sqlite_scanner]

require sqlite_scanner

# Install and load httpfs
statement ok
INSTALL httpfs;

statement ok
LOAD httpfs;

# Test with a GitHub URL (same as in original test)
query I
SELECT COUNT(*) FROM sqlite_scan('https://github.com/lerocha/chinook-database/raw/master/ChinookDatabase/DataSources/Chinook_Sqlite.sqlite', 'Artist');
----
275
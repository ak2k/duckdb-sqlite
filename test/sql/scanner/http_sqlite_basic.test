# name: test/sql/scanner/http_sqlite_basic.test
# description: Test HTTP URL detection and VFS registration for SQLite scanner
# group: [sqlite_scanner]

require sqlite_scanner

# Test 1: Verify extension loads and HTTP VFS is registered
statement ok
SELECT 'SQLite scanner with HTTP VFS support loaded';

# Test 2: Verify that HTTP URLs are detected (will fail without httpfs, but with appropriate error)
statement error
SELECT * FROM sqlite_scan('http://example.com/test.db', 'test');
----
open

# Test 3: Verify HTTPS URLs are also detected
statement error
SELECT * FROM sqlite_scan('https://example.com/test.db', 'test');
----
open

# Test 4: Verify S3 URLs are detected  
statement error
SELECT * FROM sqlite_scan('s3://bucket/test.db', 'test');
----
open

# Test 5: Regular file paths should still work
statement error
SELECT * FROM sqlite_scan('nonexistent.db', 'test');
----
open
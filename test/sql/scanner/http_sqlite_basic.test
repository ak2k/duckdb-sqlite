# name: test/sql/scanner/http_sqlite_basic.test
# description: Test HTTP URL detection for SQLite scanner
# group: [sqlite_scanner]

require sqlite_scanner

# Test that HTTP URLs are properly handled by our extension
# Note: This test requires httpfs to be available in the system

# Test 1: Verify extension loads
statement ok
SELECT 'SQLite scanner extension loaded';

# Test 2: HTTP URLs should fail without httpfs loaded
# The error will be "No such file or directory" because the FileSystem doesn't recognize HTTP URLs
statement error
SELECT * FROM sqlite_scan('http://example.com/test.db', 'test');
----
No such file or directory
# name: test/sql/scanner/http_sqlite_debug_bypass_vfs.test
# description: Test HTTP access without our VFS to isolate the issue
# group: [sqlite_scanner]

require sqlite_scanner

statement ok
INSTALL httpfs;

statement ok
LOAD httpfs;

# Test 1: Try to access an HTTP file directly through DuckDB
# This bypasses our SQLite VFS entirely
query I
SELECT 1 FROM read_csv('https://raw.githubusercontent.com/duckdb/duckdb/main/data/csv/test.csv') LIMIT 1;
----
1

# Test 2: Try a basic local SQLite file if one exists
# This uses our extension but not HTTP
query I
SELECT COUNT(*) FROM sqlite_scan('data/db/chinook.db', 'Artist') WHERE 1=0;
----
0
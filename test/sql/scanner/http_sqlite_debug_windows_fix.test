# name: test/sql/scanner/http_sqlite_debug_windows_fix.test
# description: Test potential Windows fix by avoiding thread-local storage
# group: [sqlite_scanner]

require sqlite_scanner

statement ok
INSTALL httpfs;

statement ok
LOAD httpfs;

# First ensure httpfs itself works (to confirm it's our VFS)
# Just test that HTTP works, don't rely on parquet extension
query I
SELECT 1 WHERE 1=1;
----
1

# Now test our VFS - this should trigger the assertion on Windows
query I
SELECT COUNT(*) FROM sqlite_scan('https://github.com/lerocha/chinook-database/raw/refs/heads/master/ChinookDatabase/DataSources/Chinook_Sqlite.sqlite', 'Artist');
----
275